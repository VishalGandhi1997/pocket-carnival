# Copy this file to `.env` and fill in your real AdMob ad-unit IDs.
# With no .env, the app uses Google's TEST ad units (safe for development).
# Get these from https://admob.google.com ▸ your app ▸ Ad units.
#
# Reminder: mobile apps use AdMob (not AdSense). See APK-AND-PLAYSTORE.md.

VITE_ADMOB_BANNER=ca-app-pub-XXXXXXXXXXXXXXXX/0000000000
VITE_ADMOB_INTERSTITIAL=ca-app-pub-XXXXXXXXXXXXXXXX/1111111111
VITE_ADMOB_REWARDED=ca-app-pub-XXXXXXXXXXXXXXXX/2222222222
VITE_ADMOB_APP_OPEN=ca-app-pub-XXXXXXXXXXXXXXXX/3333333333
